# Copy to .env and fill in. Never commit .env.
LLM_ORDER=groq,gemini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
THINKING_LEVEL=low

# Staff key for editing data and approving cancellations (make it long and random)
STAFF_API_KEY=

# Leave empty locally (uses SQLite files). On Vercel: your Neon *pooled* connection string.
DATABASE_URL=

# Let visitors VIEW bookings and hotels without the staff key (editing still needs it)
PUBLIC_READ=false

# Protect your LLM key on the public demo
CHAT_LIMIT_PER_HOUR=30
CHAT_LIMIT_PER_DAY=500
